<script>


/* =====================================================
   PAGE NAVIGATION
===================================================== */

function showPage(id){

    document
        .querySelectorAll(".page")
        .forEach(page => {

            page.classList.remove("active");

        });


    const target =
        document.getElementById(id);


    if(target){

        target.classList.add("active");

    }


    if(id === "final"){

        confetti();

    }

}



/* =====================================================
   BALLOON MESSAGES
===================================================== */

const balloonMessages = [

    "You deserve all the happiness in the world. ♡",

    "I hope you never forget how genuinely special you are.",

    "One of my favourite things about you is how much you care.",

    "You're cute, you're chaotic, and somehow you're still my favourite.",

    "And this is only the beginning of your little birthday surprise. ♡"

];


let popped = 0;

const totalBalloons = 5;


function popBalloon(balloon,index){

    if(
        balloon.classList.contains("popped")
    ){
        return;
    }


    balloon.classList.add("popped");


    popped++;


    document
        .getElementById("balloonCount")
        .textContent =
            popped +
            " / " +
            totalBalloons +
            " popped";


    const message =
        document.getElementById(
            "balloonMessage"
        );


    /*
       Change message
    */

    message.classList.remove("show");


    setTimeout(()=>{

        message.textContent =
            balloonMessages[index];

        message.classList.add("show");

    },150);


    /*
       Phone vibration
    */

    if(navigator.vibrate){

        navigator.vibrate(45);

    }


    /*
       After final balloon
    */

    if(popped === totalBalloons){

        setTimeout(()=>{

            showPage("cake");

        },2200);

    }

}



/* =====================================================
   CANDLE / WIND
===================================================== */

let candlesBlown = false;


function blowCandles(value){

    value = Number(value);


    document
        .getElementById("windValue")
        .textContent =
            value +
            "% wind";


    /*
       Blow candles when slider
       reaches 92%
    */

    if(
        value >= 92 &&
        !candlesBlown
    ){

        candlesBlown = true;


        document
            .querySelectorAll(".flame")
            .forEach(flame=>{

                flame.classList.add("out");

            });


        /*
           Phone vibration
        */

        if(navigator.vibrate){

            navigator.vibrate([
                40,
                60,
                40
            ]);

        }


        /*
           Show birthday message
        */

        setTimeout(()=>{

            document
                .getElementById("candleMessage")
                .classList.add("show");

        },700);

    }

}



/* =====================================================
   CONFETTI
===================================================== */

function confetti(){

    for(
        let i = 0;
        i < 45;
        i++
    ){

        const piece =
            document.createElement("div");


        piece.className =
            "confetti";


        piece.style.left =
            Math.random() *
            100 +
            "vw";


        piece.style.background = [

            "#d83d71",
            "#ffc928",
            "#8b79e8",
            "#6ac9be",
            "#ff8b69"

        ][
            Math.floor(
                Math.random() * 5
            )
        ];


        piece.style.animationDelay =
            Math.random() *
            .45 +
            "s";


        document
            .body
            .appendChild(piece);


        setTimeout(()=>{

            piece.remove();

        },2300);

    }

}


</script>

